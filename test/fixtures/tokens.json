{
  "color": {
    "$type": "color",
    "primary": {
      "base": {
        "$value": "#FF0000"
      },
      "alias": {
        "$value": "{color.primary.base}"
      },
      "deep": {
        "$value": "{color.primary.alias}"
      }
    },
    "surface": {
      "default": {
        "$value": "{color.primary.deep}",
        "$description": "Main surface color"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "8px",
      "$description": "Medium spacing"
    }
  },
  "circular": {
    "$type": "color",
    "a": {
      "$value": "{circular.b}"
    },
    "b": {
      "$value": "{circular.a}"
    }
  }
}
