{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "version": "2025.10",
  "resolutionOrder": [
    {
      "type": "set",
      "name": "base",
      "sources": [{ "$ref": "./tokens.json" }]
    },
    {
      "type": "modifier",
      "name": "mode",
      "default": "light",
      "contexts": {
        "light": [],
        "dark": [{ "$ref": "./dark-tokens.json" }]
      }
    }
  ]
}
